   148	### 2.1 Exact `rule_calibration` law
   149	
   150	$$
   151	\begin{aligned}
   152	e_t &= q_{\mathrm{ref},t} - q_{c,t}, \qquad \dot e_t = \dot q_{\mathrm{ref},t} - \dot q_{c,t},\\
   153	\hat\tau_{\mathrm{bias},t} &= -\bigl(\hat\tau_g(q_{c,t}) + \kappa\,\tau_{\mathrm{ext},t-1}\bigr),\\
   154	v_t &= \frac{\hat\tau_{\mathrm{bias},t} + J_{\mathrm{nom}}\bigl(k_p e_t + k_d \dot e_t\bigr) + \tau_{I,t}}{S_{\max}},\qquad
   155	u_{\mathrm{rule},t} = \operatorname{clip}\bigl(v_t + \varepsilon_t,\,-1,\,1\bigr),\\
   156	\tau_{I,t+1} &= \operatorname{clip}\Bigl(\tau_{I,t} + \mathbb 1[\neg\mathrm{freeze}_t]\, J_{\mathrm{nom}}\,k_i\, e_t\,\Delta t,\; -0.6\,S_{\max},\; 0.6\,S_{\max}\Bigr),\\
   157	\mathrm{freeze}_t &= \bigl(|v_t| \ge 1 \wedge \mathrm{sgn}(e_t) = \mathrm{sgn}(v_t)\bigr) \vee d_{\min,t} < 0.05 \vee d_{\max,t} < 0.05 \vee \mathrm{contact}_t .
